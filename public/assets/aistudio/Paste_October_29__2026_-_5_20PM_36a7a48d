Every assessment must be reproducible using its original feature snapshot and model/scoring versions.

### Required explanation payload

```json
{
  "assessment_id": "uuid",
  "model_version": "distress-v0.1.0",
  "policy_version": "topk-cost20-v1",
  "as_of_date": "2026-09-30",
  "default_risk": {
    "probability": null,
    "status": "benchmark_not_calibrated_for_indian_data"
  },
  "manipulation_screening": {
    "score": null,
    "status": "calculation_pending"
  },
  "top_model_contributors": [],
  "financial_indicators": [],
  "relationship_signals": [],
  "document_evidence": [],
  "data_quality_warnings": [],
  "alert_decision": {
    "selected": false,
    "priority_rank": null,
    "selection_reason": null
  }
